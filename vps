#!/data/data/com.termux/files/usr/bin/bash
set -u

RIZO_HOME="${RIZO_HOME:-$HOME/rizo-vps}"
BOTS_DIR="$RIZO_HOME/bots"
LOGS_DIR="$RIZO_HOME/logs"
STATE_DIR="$RIZO_HOME/state"
CONFIG_DIR="$RIZO_HOME/config"
SELF="$RIZO_HOME/manager/rizo"

mkdir -p "$BOTS_DIR" "$LOGS_DIR" "$STATE_DIR" "$CONFIG_DIR" "$RIZO_HOME/manager"

die() { echo "❌ $*" >&2; return 1 2>/dev/null || exit 1; }
bot_dir() { printf '%s/%s' "$BOTS_DIR" "$1"; }
session() { printf 'rizo-%s' "$1"; }
log_file() { printf '%s/%s.log' "$LOGS_DIR" "$1"; }

valid_name() {
    [[ "${1:-}" =~ ^[A-Za-z0-9._-]+$ ]]
}

require_tools() {
    local missing=()
    command -v python >/dev/null 2>&1 || missing+=("python")
    command -v tmux >/dev/null 2>&1 || missing+=("tmux")
    command -v unzip >/dev/null 2>&1 || missing+=("unzip")
    if ((${#missing[@]})); then
        echo "Missing: ${missing[*]}"
        echo "Run: pkg install -y python tmux unzip"
        return 1
    fi
}

find_entry() {
    local d="$1" entry
    if [[ -f "$d/start.sh" ]]; then echo "start.sh"; return; fi
    if [[ -f "$d/bot.py" ]]; then echo "bot.py"; return; fi
    if [[ -f "$d/main.py" ]]; then echo "main.py"; return; fi
    if [[ -f "$d/index.py" ]]; then echo "index.py"; return; fi
    if [[ -f "$d/app.py" ]]; then echo "app.py"; return; fi
    echo ""
}

read_env() {
    local d="$1"
    if [[ -f "$d/.env" ]]; then
        set -a
        # shellcheck disable=SC1090
        source "$d/.env"
        set +a
    elif [[ -f "$d/bot.env" ]]; then
        set -a
        # shellcheck disable=SC1090
        source "$d/bot.env"
        set +a
    fi
}

write_meta() {
    local name="$1" entry="$2"
    printf 'ENTRY=%q\n' "$entry" > "$(bot_dir "$name")/.rizo-meta"
}

load_entry() {
    local d="$1"
    if [[ -f "$d/.rizo-meta" ]]; then
        # shellcheck disable=SC1090
        source "$d/.rizo-meta"
        [[ -n "${ENTRY:-}" ]] && { echo "$ENTRY"; return; }
    fi
    find_entry "$d"
}

is_running() {
    tmux has-session -t "$(session "$1")" 2>/dev/null
}

ensure_venv() {
    local d="$1"
    [[ -x "$d/venv/bin/python" ]] || python -m venv "$d/venv"
}

install_bot() {
    local name="${1:-}" d
    valid_name "$name" || die "Usage: rizo install <bot-name>"
    d="$(bot_dir "$name")"
    [[ -d "$d" ]] || die "Bot does not exist: $name"
    ensure_venv "$d"

    echo "🐍 Creating/updating environment..."
    "$d/venv/bin/python" -m pip install --upgrade pip

    if [[ -f "$d/requirements.txt" ]]; then
        echo "📦 Installing requirements..."
        "$d/venv/bin/pip" install -r "$d/requirements.txt" || return 1
    else
        echo "ℹ️ No requirements.txt found; skipping package install."
    fi

    local entry
    entry="$(load_entry "$d")"
    [[ -n "$entry" ]] && write_meta "$name" "$entry"
    echo "✅ Installed: $name"
}

create_bot() {
    local name="${1:-}" d
    valid_name "$name" || die "Usage: rizo create <bot-name>"
    d="$(bot_dir "$name")"
    [[ ! -e "$d" ]] || die "Bot already exists: $name"

    mkdir -p "$d"
    python -m venv "$d/venv" || { rm -rf "$d"; return 1; }

    cat > "$d/.env" <<'EOF'
# Put environment variables here.
# Example:
# BOT_TOKEN=
EOF

    cat > "$d/requirements.txt" <<'EOF'
# Add your bot dependencies here.
# Example:
# aiogram>=3.7,<4.0
EOF

    cat > "$d/bot.py" <<'EOF'
import os
print("RIZO example bot started.")
print("Add your own bot code and requirements.txt.")
print("Environment is available through os.getenv().")
EOF

    write_meta "$name" "bot.py"
    echo "✅ Created: $name"
    echo "📁 $d"
    echo "Next: replace bot.py, edit .env, then run:"
    echo "  rizo install $name"
    echo "  rizo start $name"
}

upload_bot() {
    local name="${1:-}" zip="${2:-}" d tmp
    valid_name "$name" || die "Usage: rizo upload <bot-name> <zip-file>"
    [[ -f "$zip" ]] || die "ZIP not found: $zip"
    d="$(bot_dir "$name")"
    [[ -d "$d" ]] || die "Create the bot first: rizo create $name"

    tmp="$(mktemp -d)"
    unzip -q -o "$zip" -d "$tmp" || { rm -rf "$tmp"; die "Invalid ZIP archive"; }

    # If the archive contains one top-level directory, use its contents.
    local source="$tmp"
    local count
    count="$(find "$tmp" -mindepth 1 -maxdepth 1 | wc -l | tr -d ' ')"
    if [[ "$count" == "1" ]] && [[ -d "$(find "$tmp" -mindepth 1 -maxdepth 1 -type d)" ]]; then
        source="$(find "$tmp" -mindepth 1 -maxdepth 1 -type d)"
    fi

    cp -R "$source"/. "$d"/
    rm -rf "$tmp"
    echo "✅ Uploaded and extracted into: $d"
    echo "Run: rizo install $name"
}

set_entry() {
    local name="${1:-}" entry="${2:-}" d
    valid_name "$name" || die "Usage: rizo entry <bot-name> <file>"
    d="$(bot_dir "$name")"
    [[ -d "$d" ]] || die "Bot does not exist: $name"
    [[ -f "$d/$entry" ]] || die "Entry file not found: $entry"
    write_meta "$name" "$entry"
    echo "✅ Entry set to: $entry"
}

start_bot() {
    local name="${1:-}" d entry sess logfile
    valid_name "$name" || die "Usage: rizo start <bot-name>"
    d="$(bot_dir "$name")"
    [[ -d "$d" ]] || die "Bot does not exist: $name"
    is_running "$name" && { echo "🟢 Already running: $name"; return 0; }

    ensure_venv "$d"
    entry="$(load_entry "$d")"
    [[ -n "$entry" ]] || die "No entry file found. Use: rizo entry $name <file>"
    [[ -f "$d/$entry" ]] || die "Entry file missing: $entry"

    local logfile
    logfile="$(log_file "$name")"
    touch "$logfile"

    sess="$(session "$name")"
    tmux new-session -d -s "$sess"
    tmux send-keys -t "$sess" "cd $(printf '%q' "$d")" C-m
    tmux send-keys -t "$sess" "source venv/bin/activate" C-m

    if [[ "$entry" == *.sh ]]; then
        tmux send-keys -t "$sess" "chmod +x $(printf '%q' "$entry")" C-m
        tmux send-keys -t "$sess" "while true; do ./${entry@Q} >> $(printf '%q' "$logfile") 2>&1; code=\$?; echo \"[RIZO] exited \$code - restarting in 3s\" >> $(printf '%q' "$logfile"); sleep 3; done" C-m
    else
        tmux send-keys -t "$sess" "while true; do python $(printf '%q' "$entry") >> $(printf '%q' "$logfile") 2>&1; code=\$?; echo \"[RIZO] exited \$code - restarting in 3s\" >> $(printf '%q' "$logfile"); sleep 3; done" C-m
    fi

    echo "🚀 Started: $name"
}

stop_bot() {
    local name="${1:-}"
    valid_name "$name" || die "Usage: rizo stop <bot-name>"
    if is_running "$name"; then
        tmux kill-session -t "$(session "$name")"
        echo "🛑 Stopped: $name"
    else
        echo "ℹ️ Not running: $name"
    fi
}

restart_bot() {
    stop_bot "$1" >/dev/null 2>&1 || true
    sleep 1
    start_bot "$1"
}

status_bot() {
    local name="${1:-}"
    valid_name "$name" || die "Usage: rizo status <bot-name>"
    if is_running "$name"; then
        echo "🟢 $name  RUNNING"
    else
        echo "🔴 $name  STOPPED"
    fi
}

list_bots() {
    local found=0 name d
    printf '%-24s %s\n' "BOT" "STATUS"
    printf '%-24s %s\n' "------------------------" "--------"
    shopt -s nullglob
    for d in "$BOTS_DIR"/*; do
        [[ -d "$d" ]] || continue
        name="$(basename "$d")"
        found=1
        if is_running "$name"; then
            printf '%-24s %s\n' "$name" "🟢 RUNNING"
        else
            printf '%-24s %s\n' "$name" "🔴 STOPPED"
        fi
    done
    shopt -u nullglob
    ((found)) || echo "No bots created."
}

logs_bot() {
    local name="${1:-}" file
    valid_name "$name" || die "Usage: rizo logs <bot-name>"
    file="$(log_file "$name")"
    [[ -f "$file" ]] || die "No log file for: $name"
    tail -n 100 "$file"
}

follow_logs() {
    local name="${1:-}" file
    valid_name "$name" || die "Usage: rizo logs-live <bot-name>"
    file="$(log_file "$name")"
    touch "$file"
    tail -n 50 -f "$file"
}

delete_bot() {
    local name="${1:-}" d answer
    valid_name "$name" || die "Usage: rizo delete <bot-name>"
    d="$(bot_dir "$name")"
    [[ -d "$d" ]] || die "Bot does not exist: $name"
    read -r -p "Delete '$name' and all its files? [y/N] " answer
    [[ "$answer" =~ ^[Yy]$ ]] || { echo "Cancelled."; return; }
    stop_bot "$name" >/dev/null 2>&1 || true
    rm -rf "$d" "$(log_file "$name")"
    echo "🗑️ Deleted: $name"
}

info_bot() {
    local name="${1:-}" d entry
    valid_name "$name" || die "Usage: rizo info <bot-name>"
    d="$(bot_dir "$name")"
    [[ -d "$d" ]] || die "Bot does not exist: $name"
    entry="$(load_entry "$d")"
    echo "Name:      $name"
    echo "Directory: $d"
    echo "Entry:     ${entry:-none}"
    echo "Status:    $(is_running "$name" && echo RUNNING || echo STOPPED)"
    if [[ -x "$d/venv/bin/python" ]]; then
        echo "Python:    $("$d/venv/bin/python" --version 2>&1)"
    fi
}

system_info() {
    echo "RIZO Mini VPS"
    echo "Home: $RIZO_HOME"
    echo "Bots: $(find "$BOTS_DIR" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l | tr -d ' ')"
    if command -v free >/dev/null 2>&1; then free -h | head -n 2; fi
    if command -v df >/dev/null 2>&1; then df -h "$RIZO_HOME" | tail -n 1; fi
}

help_menu() {
    cat <<'EOF'

RIZO Mini VPS
────────────────────────────────────
rizo                         Dashboard
rizo create NAME             Create a bot
rizo upload NAME FILE.zip    Upload/extract ZIP
rizo install NAME            Install requirements
rizo entry NAME FILE         Set startup file
rizo start NAME              Start + auto-restart
rizo stop NAME               Stop
rizo restart NAME            Restart
rizo status NAME             Status
rizo list                    List bots
rizo logs NAME               Last 100 log lines
rizo logs-live NAME          Follow live logs
rizo info NAME               Bot information
rizo system                 Phone/storage information
rizo delete NAME             Delete bot
rizo update                 Pull latest GitHub version
rizo help                    Help

Each bot has its own Python virtual environment.
EOF
}

update_manager() {
    local repo="${RIZO_REPO_URL:-}"
    [[ -n "$repo" ]] || die "Set RIZO_REPO_URL first, or use the GitHub installer's update command."
    command -v curl >/dev/null 2>&1 || die "Install curl: pkg install -y curl"
    curl -fsSL "$repo" -o "$SELF" || die "Update download failed"
    chmod +x "$SELF"
    echo "✅ RIZO manager updated."
}

dashboard() {
    echo
    echo "╔══════════════════════════════════════╗"
    echo "║        R I Z O   M I N I   V P S    ║"
    echo "║          Android Bot Hosting        ║"
    echo "╚══════════════════════════════════════╝"
    echo
    list_bots
    echo
    echo "Run 'rizo help' for commands."
}

case "${1:-}" in
    create) create_bot "${2:-}" ;;
    upload) upload_bot "${2:-}" "${3:-}" ;;
    install) install_bot "${2:-}" ;;
    entry) set_entry "${2:-}" "${3:-}" ;;
    start) start_bot "${2:-}" ;;
    stop) stop_bot "${2:-}" ;;
    restart) restart_bot "${2:-}" ;;
    status) [[ -n "${2:-}" ]] && status_bot "$2" || list_bots ;;
    list) list_bots ;;
    logs) logs_bot "${2:-}" ;;
    logs-live) follow_logs "${2:-}" ;;
    info) info_bot "${2:-}" ;;
    system) system_info ;;
    delete) delete_bot "${2:-}" ;;
    update) update_manager ;;
    help|-h|--help) help_menu ;;
    "") dashboard ;;
    *) echo "❌ Unknown command: $1"; help_menu; exit 1 ;;
esac
