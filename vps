#!/data/data/com.termux/files/usr/bin/bash

BASE="$HOME/rizo-vps"
BOTS="$BASE/bots"
LOGS="$BASE/logs"

R='\033[1;31m'
C='\033[1;36m'
G='\033[1;32m'
Y='\033[1;33m'
W='\033[1;37m'
D='\033[0;90m'
N='\033[0m'

banner() {
    clear
    echo -e "${R}"
    echo '██████╗ ██╗███████╗ ██████╗'
    echo '██╔══██╗██║╚══███╔╝██╔═══██╗'
    echo '██████╔╝██║  ███╔╝ ██║   ██║'
    echo '██╔══██╗██║ ███╔╝  ██║   ██║'
    echo '██║  ██║██║███████╗╚██████╔╝'
    echo '╚═╝  ╚═╝╚═╝╚══════╝ ╚═════╝'
    echo -e "${N}"
    echo -e "${C}       MINI VPS  •  TERMUX${N}"
    echo -e "${D}  Your phone. Your bots. Your server.${N}"
    echo -e "${C}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${N}"
}

valid_name() {
    [[ "$1" =~ ^[a-zA-Z0-9_-]+$ ]]
}

need_name() {
    if [ -z "$2" ] || ! valid_name "$2"; then
        echo -e "${Y}Usage: rizo $1 <bot-name>${N}"
        exit 1
    fi
}

bot_exists() {
    [ -d "$BOTS/$1" ]
}

create_bot() {
    NAME="$1"
    need_name create "$NAME"

    if bot_exists "$NAME"; then
        echo -e "${Y}Bot already exists: $NAME${N}"
        return 1
    fi

    DIR="$BOTS/$NAME"
    mkdir -p "$DIR"

    echo -e "${C}[1/3] Creating Python environment...${N}"
    python -m venv "$DIR/venv" || return 1

    cat > "$DIR/requirements.txt" <<'REQ'
aiogram>=3.7,<4.0
REQ

    cat > "$DIR/bot.env" <<'ENV'
BOT_TOKEN=
ENV
    chmod 600 "$DIR/bot.env"

    cat > "$DIR/bot.py" <<'PY'
import asyncio
import os
from aiogram import Bot, Dispatcher
from aiogram.filters import CommandStart
from aiogram.types import Message

TOKEN = os.getenv("BOT_TOKEN")

if not TOKEN:
    raise RuntimeError("Add your Telegram token to bot.env")

dp = Dispatcher()

@dp.message(CommandStart())
async def start(message: Message):
    await message.answer("⚡ Your bot is online!")

async def main():
    bot = Bot(TOKEN)
    print("RIZO bot is starting...")
    try:
        await dp.start_polling(bot)
    finally:
        await bot.session.close()

if __name__ == "__main__":
    asyncio.run(main())
PY

    echo -e "${C}[2/3] Installing requirements...${N}"
    "$DIR/venv/bin/pip" install --upgrade pip
    "$DIR/venv/bin/pip" install -r "$DIR/requirements.txt" || {
        echo -e "${Y}Dependency installation failed.${N}"
        echo "Retry with: rizo install $NAME"
        return 1
    }

    echo -e "${C}[3/3] Bot created!${N}"
    echo
    echo -e "${G}✔ Bot: $NAME${N}"
    echo -e "${W}Folder: $DIR${N}"
    echo
    echo -e "${Y}Next: Add your token${N}"
    echo "nano $DIR/bot.env"
    echo
    echo "Then run: rizo start $NAME"
}

install_deps() {
    NAME="$1"
    need_name install "$NAME"

    if ! bot_exists "$NAME"; then
        echo -e "${R}Bot not found.${N}"
        return 1
    fi

    DIR="$BOTS/$NAME"
    [ -d "$DIR/venv" ] || python -m venv "$DIR/venv"

    echo -e "${C}Installing packages for $NAME...${N}"
    "$DIR/venv/bin/pip" install -r "$DIR/requirements.txt"
}

start_bot() {
    NAME="$1"
    need_name start "$NAME"

    if ! bot_exists "$NAME"; then
        echo -e "${R}Bot not found. Create it first.${N}"
        return 1
    fi

    DIR="$BOTS/$NAME"

    if tmux has-session -t "rizo-$NAME" 2>/dev/null; then
        echo -e "${Y}● $NAME is already running.${N}"
        return
    fi

    if [ ! -f "$DIR/bot.py" ]; then
        echo -e "${R}bot.py not found.${N}"
        return 1
    fi

    mkdir -p "$LOGS"
    touch "$LOGS/$NAME.log"

    tmux new-session -d -s "rizo-$NAME" \
        "cd '$DIR'; set -a; source '$DIR/bot.env'; set +a; exec '$DIR/venv/bin/python' -u bot.py >> '$LOGS/$NAME.log' 2>&1"

    sleep 1

    if tmux has-session -t "rizo-$NAME" 2>/dev/null; then
        echo -e "${G}✔ Started: $NAME${N}"
        echo -e "${D}Logs: rizo logs $NAME${N}"
    else
        echo -e "${R}Bot exited. Check: rizo logs $NAME${N}"
    fi
}

stop_bot() {
    NAME="$1"
    need_name stop "$NAME"

    if tmux has-session -t "rizo-$NAME" 2>/dev/null; then
        tmux kill-session -t "rizo-$NAME"
        echo -e "${Y}■ Stopped: $NAME${N}"
    else
        echo -e "${Y}$NAME is not running.${N}"
    fi
}

restart_bot() {
    NAME="$1"
    need_name restart "$NAME"

    if tmux has-session -t "rizo-$NAME" 2>/dev/null; then
        tmux kill-session -t "rizo-$NAME"
    fi

    sleep 1
    start_bot "$NAME"
}

list_bots() {
    echo -e "${C}━━━━━━━━━━━━ YOUR BOTS ━━━━━━━━━━━━${N}"

    FOUND=0

    for DIR in "$BOTS"/*; do
        [ -d "$DIR" ] || continue
        FOUND=1
        NAME="$(basename "$DIR")"

        if tmux has-session -t "rizo-$NAME" 2>/dev/null; then
            echo -e "${G}● ONLINE${N}  $NAME"
        else
            echo -e "${R}● OFFLINE${N} $NAME"
        fi
    done

    [ "$FOUND" = "0" ] && echo "No bots yet. Run: rizo create bot1"
    echo -e "${C}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${N}"
}

status_bots() {
    ONLINE=0
    OFFLINE=0

    for DIR in "$BOTS"/*; do
        [ -d "$DIR" ] || continue
        NAME="$(basename "$DIR")"

        if tmux has-session -t "rizo-$NAME" 2>/dev/null; then
            ONLINE=$((ONLINE + 1))
        else
            OFFLINE=$((OFFLINE + 1))
        fi
    done

    echo -e "${C}╭──────── RIZO STATUS ────────╮${N}"
    echo -e "${C}│${N} ${G}● Online bots : $ONLINE${N}"
    echo -e "${C}│${N} ${R}● Offline bots: $OFFLINE${N}"
    echo -e "${C}│${N} Python       : $(python --version 2>&1)"
    echo -e "${C}│${N} Platform     : Android / Termux"
    echo -e "${C}╰─────────────────────────────╯${N}"
}

show_logs() {
    NAME="$1"
    need_name logs "$NAME"

    LOG="$LOGS/$NAME.log"

    if [ -f "$LOG" ]; then
        tail -n 80 -f "$LOG"
    else
        echo -e "${Y}No logs for $NAME yet.${N}"
    fi
}

delete_bot() {
    NAME="$1"
    need_name delete "$NAME"

    if ! bot_exists "$NAME"; then
        echo -e "${R}Bot not found.${N}"
        return 1
    fi

    echo -e "${R}This will permanently delete $NAME and its files.${N}"
    read -r -p "Type DELETE to confirm: " CONFIRM

    if [ "$CONFIRM" != "DELETE" ]; then
        echo "Cancelled."
        return
    fi

    if tmux has-session -t "rizo-$NAME" 2>/dev/null; then
        tmux kill-session -t "rizo-$NAME"
    fi

    rm -rf "$BOTS/$NAME"
    rm -f "$LOGS/$NAME.log"

    echo -e "${G}✔ Deleted: $NAME${N}"
}

help_menu() {
    echo -e "${C}COMMANDS${N}"
    echo
    echo -e "${G}rizo${N}                  Dashboard"
    echo -e "${G}rizo create <name>${N}    Create bot"
    echo -e "${G}rizo install <name>${N}   Install requirements"
    echo -e "${G}rizo start <name>${N}     Start bot"
    echo -e "${G}rizo stop <name>${N}      Stop bot"
    echo -e "${G}rizo restart <name>${N}   Restart bot"
    echo -e "${G}rizo status${N}           Bot statistics"
    echo -e "${G}rizo list${N}             List all bots"
    echo -e "${G}rizo logs <name>${N}      Follow logs"
    echo -e "${G}rizo delete <name>${N}    Delete bot"
    echo -e "${G}rizo help${N}             Show help"
    echo
}

mkdir -p "$BOTS" "$LOGS"

case "$1" in
    create)  create_bot "$2" ;;
    install) install_deps "$2" ;;
    start)   start_bot "$2" ;;
    stop)    stop_bot "$2" ;;
    restart) restart_bot "$2" ;;
    status)  banner; status_bots ;;
    list)    banner; list_bots ;;
    logs)    show_logs "$2" ;;
    delete)  delete_bot "$2" ;;
    help|-h|--help) banner; help_menu ;;
    "")
        banner
        status_bots
        echo
        help_menu
        ;;
    *)
        echo -e "${R}Unknown command: $1${N}"
        echo "Run: rizo help"
        exit 1
        ;;
esac
