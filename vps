# -------------------- CREATE --------------------

create_bot() {

    local name="${1:-}"

    if ! valid_name "$name"; then
        echo -e "${RED}❌ Usage: rizo create <bot-name>${RESET}"
        return 1
    fi

    local dir
    dir="$(bot_dir "$name")"

    if [[ -d "$dir" ]]; then
        echo -e "${YELLOW}⚠ Bot already exists: $name${RESET}"
        return 1
    fi

    mkdir -p "$dir"

    echo -e "${CYAN}[*] Creating Python environment...${RESET}"

    python -m venv "$dir/venv"

    cat > "$dir/requirements.txt" <<'EOF'
# Add your Python packages here.
# Example:
# aiogram>=3.7,<4.0
EOF

    cat > "$dir/.env" <<'EOF'
# Bot environment variables
# Example:
# BOT_TOKEN=
EOF

    cat > "$dir/bot.py" <<'EOF'
print("RIZO HACKER BOT")
print("Replace this file with your own bot code.")
EOF

    echo "ENTRY=bot.py" > "$dir/.rizo-meta"

    echo
    echo -e "${GREEN}╔════════════════════════════════════════╗${RESET}"
    echo -e "${GREEN}║        BOT CREATED SUCCESSFULLY        ║${RESET}"
    echo -e "${GREEN}╚════════════════════════════════════════╝${RESET}"
    echo
    echo -e "${WHITE}Name:${RESET} $name"
    echo -e "${WHITE}Path:${RESET} $dir"
    echo
    echo -e "${CYAN}Next:${RESET}"
    echo "  rizo upload $name /path/to/bot.zip"
    echo "  rizo install $name"
    echo "  rizo start $name"
}

# -------------------- UPLOAD --------------------

upload_bot() {

    local name="${1:-}"
    local zip="${2:-}"

    if ! valid_name "$name"; then
        echo -e "${RED}❌ Usage: rizo upload <name> <zip>${RESET}"
        return 1
    fi

    local dir
    dir="$(bot_dir "$name")"

    [[ -d "$dir" ]] || {
        echo -e "${RED}❌ Bot doesn't exist. Create it first.${RESET}"
        return 1
    }

    [[ -f "$zip" ]] || {
        echo -e "${RED}❌ ZIP file not found.${RESET}"
        return 1
    }

    command -v unzip >/dev/null 2>&1 || {
        echo -e "${RED}❌ unzip missing.${RESET}"
        echo "Run: pkg install -y unzip"
        return 1
    }

    echo -e "${MAGENTA}[*] Extracting bot...${RESET}"

    unzip -o "$zip" -d "$dir" >/dev/null

    echo
    echo -e "${GREEN}✔ BOT UPLOAD COMPLETE${RESET}"
    echo -e "${WHITE}Location:${RESET} $dir"
}

# -------------------- INSTALL --------------------

install_bot() {

    local name="${1:-}"

    valid_name "$name" || {
        echo -e "${RED}❌ Usage: rizo install <name>${RESET}"
        return 1
    }

    local dir
    dir="$(bot_dir "$name")"

    [[ -d "$dir" ]] || {
        echo -e "${RED}❌ Bot not found.${RESET}"
        return 1
    }

    [[ -x "$dir/venv/bin/pip" ]] || {
        python -m venv "$dir/venv"
    }

    echo
    echo -e "${BLUE}╔════════════════════════════════════════╗${RESET}"
    echo -e "${BLUE}║       INSTALLING BOT DEPENDENCIES      ║${RESET}"
    echo -e "${BLUE}╚════════════════════════════════════════╝${RESET}"

    "$dir/venv/bin/python" -m pip install --upgrade pip

    if [[ -f "$dir/requirements.txt" ]]; then
        "$dir/venv/bin/pip" install -r "$dir/requirements.txt"
    fi

    echo
    echo -e "${GREEN}✔ INSTALLATION COMPLETE${RESET}"
}

# -------------------- ENTRY --------------------

set_entry() {

    local name="${1:-}"
    local entry="${2:-}"

    valid_name "$name" || {
        echo -e "${RED}❌ Usage: rizo entry <name> <file>${RESET}"
        return 1
    }

    local dir
    dir="$(bot_dir "$name")"

    [[ -f "$dir/$entry" ]] || {
        echo -e "${RED}❌ File not found: $entry${RESET}"
        return 1
    }

    echo "ENTRY=$entry" > "$dir/.rizo-meta"

    echo -e "${GREEN}✔ Startup file set: $entry${RESET}"
}

# -------------------- START --------------------

start_bot() {

    local name="${1:-}"

    valid_name "$name" || {
        echo -e "${RED}❌ Usage: rizo start <name>${RESET}"
        return 1
    }

    local dir
    dir="$(bot_dir "$name")"

    [[ -d "$dir" ]] || {
        echo -e "${RED}❌ Bot not found.${RESET}"
        return 1
    }

    if is_running "$name"; then
        echo -e "${YELLOW}⚠ Bot already running.${RESET}"
        return 0
    fi

    local entry="bot.py"

    if [[ -f "$dir/.rizo-meta" ]]; then
        source "$dir/.rizo-meta"
        entry="${ENTRY:-bot.py}"
    elif [[ -f "$dir/main.py" ]]; then
        entry="main.py"
    fi

    [[ -f "$dir/$entry" ]] || {
        echo -e "${RED}❌ Entry file not found: $entry${RESET}"
        return 1
    }

    local logfile
    logfile="$(bot_log "$name")"

    touch "$logfile"

    tmux new-session -d -s "$(bot_session "$name")"

    tmux send-keys \
        -t "$(bot_session "$name")" \
        "cd $(printf '%q' "$dir") && source venv/bin/activate && while true; do python $(printf '%q' "$entry") >> $(printf '%q' "$logfile") 2>&1; echo '[RIZO] Bot stopped/crashed - restarting in 3s' >> $(printf '%q' "$logfile"); sleep 3; done" \
        C-m

    echo
    echo -e "${GREEN}╔════════════════════════════════════════╗${RESET}"
    echo -e "${GREEN}║           BOT IS ONLINE 🚀             ║${RESET}"
    echo -e "${GREEN}╚════════════════════════════════════════╝${RESET}"
    echo
    echo -e "${WHITE}Bot:${RESET} $name"
    echo -e "${WHITE}Entry:${RESET} $entry"
}

# -------------------- STOP --------------------

stop_bot() {

    local name="${1:-}"

    valid_name "$name" || {
        echo -e "${RED}❌ Usage: rizo stop <name>${RESET}"
        return 1
    }

    if is_running "$name"; then
        tmux kill-session -t "$(bot_session "$name")"
        echo -e "${RED}■ Bot stopped: $name${RESET}"
    else
        echo -e "${YELLOW}⚠ Bot is already stopped.${RESET}"
    fi
}

# -------------------- RESTART --------------------

restart_bot() {

    stop_bot "$1" >/dev/null 2>&1 || true

    sleep 1

    start_bot "$1"
}

# -------------------- STATUS --------------------

status_bot() {

    local name="${1:-}"

    valid_name "$name" || {
        echo -e "${RED}❌ Usage: rizo status <name>${RESET}"
        return 1
    }

    echo

    if is_running "$name"; then
        echo -e "${GREEN}╔══════════════════════════════════════╗${RESET}"
        echo -e "${GREEN}║          ● ONLINE / RUNNING         ║${RESET}"
        echo -e "${GREEN}╚══════════════════════════════════════╝${RESET}"
    else
        echo -e "${RED}╔══════════════════════════════════════╗${RESET}"
        echo -e "${RED}║          ● OFFLINE / STOPPED        ║${RESET}"
        echo -e "${RED}╚══════════════════════════════════════╝${RESET}"
    fi

    echo -e "${WHITE}Bot:${RESET} $name"
}

# -------------------- LIST --------------------

list_bots() {

    echo
    echo -e "${BOLD}${MAGENTA}┌───────────────────────────────────────────────────────────┐${RESET}"
    echo -e "${MAGENTA}│                 RIZO BOT SERVERS                         │${RESET}"
    echo -e "${MAGENTA}├────────────────────────┬──────────────────────────────────┤${RESET}"
    echo -e "${MAGENTA}│ BOT NAME               │ STATUS                           │${RESET}"
    echo -e "${MAGENTA}├────────────────────────┼──────────────────────────────────┤${RESET}"

    local found=0
    local dir
    local name

    shopt -s nullglob

    for dir in "$BOTS_DIR"/*; do

        [[ -d "$dir" ]] || continue

        found=1

        name="$(basename "$dir")"

        if is_running "$name"; then
            printf "${MAGENTA}│${RESET} %-22s ${MAGENTA}│${RESET} ${GREEN}● RUNNING${RESET}                       ${MAGENTA}│${RESET}\n" "$name"
        else
            printf "${MAGENTA}│${RESET} %-22s ${MAGENTA}│${RESET} ${RED}● STOPPED${RESET}                       ${MAGENTA}│${RESET}\n" "$name"
        fi

    done

    shopt -u nullglob

    echo -e "${MAGENTA}└────────────────────────┴──────────────────────────────────┘${RESET}"

    if [[ "$found" == "0" ]]; then
        echo -e "${GRAY}No bots created yet.${RESET}"
    fi

    echo
}

# -------------------- LOGS --------------------

logs_bot() {

    local name="${1:-}"

    valid_name "$name" || {
        echo -e "${RED}❌ Usage: rizo logs <name>${RESET}"
        return 1
    }

    local logfile
    logfile="$(bot_log "$name")"

    [[ -f "$logfile" ]] || {
        echo -e "${YELLOW}No logs available.${RESET}"
        return 1
    }

    echo -e "${CYAN}━━━ RIZO LIVE LOG BUFFER ━━━${RESET}"
    tail -n 100 "$logfile"
}

# -------------------- LIVE LOGS --------------------

live_logs() {

    local name="${1:-}"

    local logfile
    logfile="$(bot_log "$name")"

    touch "$logfile"

    echo -e "${CYAN}Following logs for $name ...${RESET}"

    tail -f "$logfile"
}

# -------------------- INFO --------------------

info_bot() {

    local name="${1:-}"

    valid_name "$name" || {
        echo -e "${RED}❌ Usage: rizo info <name>${RESET}"
        return 1
    }

    local dir
    dir="$(bot_dir "$name")"

    [[ -d "$dir" ]] || {
        echo -e "${RED}❌ Bot not found.${RESET}"
        return 1
    }

    echo
    line

    echo -e "${CYAN}BOT NAME   ${WHITE}: ${MAGENTA}$name${RESET}"
    echo -e "${CYAN}DIRECTORY  ${WHITE}: ${WHITE}$dir${RESET}"

    if is_running "$name"; then
        echo -e "${CYAN}STATUS     ${WHITE}: ${GREEN}RUNNING${RESET}"
    else
        echo -e "${CYAN}STATUS     ${WHITE}: ${RED}STOPPED${RESET}"
    fi

    if [[ -f "$dir/.rizo-meta" ]]; then
        source "$dir/.rizo-meta"
        echo -e "${CYAN}ENTRY      ${WHITE}: ${YELLOW}${ENTRY:-unknown}${RESET}"
    fi

    line
    echo
}

# -------------------- SYSTEM --------------------

system_info() {

    echo
    echo -e "${BOLD}${BLUE}╔════════════════════════════════════════╗${RESET}"
    echo -e "${BOLD}${BLUE}║           RIZO SYSTEM MONITOR          ║${RESET}"
    echo -e "${BOLD}${BLUE}╚════════════════════════════════════════╝${RESET}"

    echo

    echo -e "${CYAN}USER:${RESET} $USER"
    echo -e "${CYAN}HOME:${RESET} $HOME"

    if command -v python >/dev/null 2>&1; then
        echo -e "${CYAN}PYTHON:${RESET} $(python --version 2>&1)"
    fi

    if command -v tmux >/dev/null 2>&1; then
        echo -e "${CYAN}TMUX:${RESET} $(tmux -V)"
    fi

    echo

    echo -e "${YELLOW}STORAGE${RESET}"

    df -h "$HOME" 2>/dev/null | tail -n 1

    echo
}

# -------------------- DELETE --------------------

delete_bot() {

    local name="${1:-}"

    valid_name "$name" || {
        echo -e "${RED}❌ Usage: rizo delete <name>${RESET}"
        return 1
    }

    local dir
    dir="$(bot_dir "$name")"

    [[ -d "$dir" ]] || {
        echo -e "${RED}❌ Bot not found.${RESET}"
        return 1
    }

    echo -e "${RED}⚠ WARNING: This deletes the complete bot.${RESET}"

    read -r -p "Type DELETE to continue: " answer

    [[ "$answer" == "DELETE" ]] || {
        echo -e "${YELLOW}Cancelled.${RESET}"
        return
    }

    stop_bot "$name" >/dev/null 2>&1 || true

    rm -rf "$dir"
    rm -f "$(bot_log "$name")"

    echo -e "${GREEN}✔ Bot deleted.${RESET}"
}

# -------------------- HELP --------------------

help_menu() {

    banner

    command_panel

    echo -e "${WHITE}Examples:${RESET}"
    echo
    echo -e "${CYAN}rizo create mybot${RESET}"
    echo -e "${CYAN}rizo upload mybot ~/storage/downloads/mybot.zip${RESET}"
    echo -e "${CYAN}rizo install mybot${RESET}"
    echo -e "${CYAN}rizo start mybot${RESET}"
    echo -e "${CYAN}rizo status mybot${RESET}"
    echo -e "${CYAN}rizo logs mybot${RESET}"
    echo
}

# -------------------- DASHBOARD --------------------

dashboard() {

    banner

    list_bots

    echo -e "${BOLD}${WHITE}QUICK COMMANDS${RESET}"
    echo
    echo -e "${RED}›${RESET} ${CYAN}rizo create NAME${RESET}"
    echo -e "${MAGENTA}›${RESET} ${CYAN}rizo upload NAME FILE.zip${RESET}"
    echo -e "${BLUE}›${RESET} ${CYAN}rizo start NAME${RESET}"
    echo -e "${GREEN}›${RESET} ${CYAN}rizo status NAME${RESET}"
    echo -e "${YELLOW}›${RESET} ${CYAN}rizo help${RESET}"
    echo
}

# -------------------- MAIN --------------------

case "${1:-}" in

    create)
        create_bot "${2:-}"
        ;;

    upload)
        upload_bot "${2:-}" "${3:-}"
        ;;

    install)
        install_bot "${2:-}"
        ;;

    entry)
        set_entry "${2:-}" "${3:-}"
        ;;

    start)
        start_bot "${2:-}"
        ;;

    stop)
        stop_bot "${2:-}"
        ;;

    restart)
        restart_bot "${2:-}"
        ;;

    status)
        if [[ -n "${2:-}" ]]; then
            status_bot "$2"
        else
            list_bots
        fi
        ;;

    list)
        list_bots
        ;;

    logs)
        logs_bot "${2:-}"
        ;;

    logs-live)
        live_logs "${2:-}"
        ;;

    info)
        info_bot "${2:-}"
        ;;

    system)
        system_info
        ;;

    delete)
        delete_bot "${2:-}"
        ;;

    help|--help|-h)
        help_menu
        ;;

    "")
        dashboard
        ;;

    *)
        echo -e "${RED}❌ Unknown command: $1${RESET}"
        echo
        echo -e "${CYAN}Run: rizo help${RESET}"
        ;;

esac