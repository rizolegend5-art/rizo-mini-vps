# RIZO HACKER RGB — MINI VPS / BOT HOST MANAGER
# ============================================================

set -u

RIZO_HOME="${RIZO_HOME:-$HOME/rizo-vps}"
BOTS_DIR="$RIZO_HOME/bots"
LOGS_DIR="$RIZO_HOME/logs"
STATE_DIR="$RIZO_HOME/state"
MANAGER_DIR="$RIZO_HOME/manager"

mkdir -p "$BOTS_DIR" "$LOGS_DIR" "$STATE_DIR" "$MANAGER_DIR"

# -------------------- RGB COLORS --------------------

RESET='\033[0m'
BOLD='\033[1m'

RED='\033[1;91m'
MAGENTA='\033[1;95m'
BLUE='\033[1;94m'
CYAN='\033[1;96m'
GREEN='\033[1;92m'
YELLOW='\033[1;93m'
WHITE='\033[1;97m'
GRAY='\033[1;90m'

# -------------------- BASIC HELPERS --------------------

pause() {
    sleep 0.15
}

line() {
    echo -e "${MAGENTA}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
}

valid_name() {
    [[ "${1:-}" =~ ^[A-Za-z0-9._-]+$ ]]
}

bot_dir() {
    echo "$BOTS_DIR/$1"
}

bot_session() {
    echo "rizo-$1"
}

bot_log() {
    echo "$LOGS_DIR/$1.log"
}

is_running() {
    tmux has-session -t "$(bot_session "$1")" 2>/dev/null
}

